#: src/iphanpy-overrides/components/iphanpy-settings.jsx:39
msgid "Open external links in Default Browser"
msgstr "Abrir ligazóns externas no navegador predeterminado"

#: src/iphanpy-overrides/components/iphanpy-settings.jsx:44
msgid "If disabled, links will be opened in the in-app browser."
msgstr "Se está desactivado, as ligazóns abriranse no navegador integrado."

#: src/iphanpy-overrides/components/iphanpy-settings.jsx:62
msgid "Tap status bar to scroll to top"
msgstr "Toca a barra de estado para ir arriba"

#: src/iphanpy-overrides/components/iphanpy-settings.jsx:79
msgid "Use native tab bar"
msgstr "Usar a barra de lapelas nativa"

#: src/iphanpy-overrides/components/iphanpy-settings.jsx:84
msgid "Experimental. Applies when shortcuts are shown as a tab bar."
msgstr "Experimental. Aplícase cando os atallos se mostran como barra de lapelas."
